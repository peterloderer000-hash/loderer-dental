// ─── Pomocné ──────────────────────────────────────────────────────────────────
function fmtDate(s: string) {
  return new Date(s).toLocaleDateString('sk-SK', { day: 'numeric', month: 'long', year: 'numeric' });
}
function fmtEur(n: number | null) {
  if (n === null) return '—';
  return `${n.toFixed(2).replace('.', ',')} €`;
}

