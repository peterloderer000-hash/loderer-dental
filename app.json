{
  "expo": {
    "name": "Loderer Dental",
    "slug": "dentalapp",
    "owner": "peterloderers-organization",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loderer-dental",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.loderendental.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotenie zubov pre zubná kartu a profilový obrázok.",
        "NSPhotoLibraryUsageDescription": "Výber profilového obrázka a fotiek zubov.",
        "NSPhotoLibraryAddUsageDescription": "Ukladanie fotiek zubov.",
        "NSUserNotificationsUsageDescription": "Pripomienky termínov a správy od ambulancie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111827",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.loderendental.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#111827"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2e9a0cd8-94a5-4015-8c7d-6751065dbcef"
      },
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2e9a0cd8-94a5-4015-8c7d-6751065dbcef"
    }
  }
}
